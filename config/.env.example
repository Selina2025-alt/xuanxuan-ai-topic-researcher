# Configuration inventory only. This file is not automatically consumed by
# Hermes or lark-cli. Copy values into the official local setup flow for each
# tool. Never commit the populated version.

# Choose only the provider you actually use.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional web collection provider.
FIRECRAWL_API_KEY=

# Your own Feishu application. Store the secret through lark-cli/Hermes setup.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Your own business storage. These are locations, not author-owned resources.
FEISHU_BASE_URL=
FEISHU_RESEARCH_FOLDER_URL=

# Runtime choices.
HERMES_PROFILE=topicresearchagent
MODEL_PROVIDER=
MODEL_NAME=
